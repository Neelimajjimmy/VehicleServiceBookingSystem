@model project3VehicleServiceBookingApp.Models.PasswordChangeDto
@{
}
<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">
            <h3>Change Password</h3>

            <div class="card shadow">


                <div class="card-body">
                    

                    <form asp-action="ChangePassword" method="post">
                        <div class="mb-3">
                            <label>Old Password</label>
                            <input asp-for="password" type="text"
                                   class="form-control" />
  <span asp-validation-for="password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label>New Password</label>
                            <input asp-for="newpwd" type="password"
                                      class="form-control"/>
                            <span asp-validation-for="newpwd" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label>Confirm Password</label>
                            <input asp-for="confirmpwd" type="password"
                                   class="form-control" />
                            <span asp-validation-for="confirmpwd" class="text-danger"></span>
                        </div>


                        <button class="submit-btn mb-3">
                            Submit
                        </button>

                    </form>
                  
                </div>
                
            </div>

        </div>

    </div>

</div>

@if (TempData["pwmsg"] != null)
{
    <script>
        alert('@TempData["pwmsg"]');
    </script>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}