@model project3VehicleServiceBookingApp.Models.ServiceType
@{
}
<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">
            <h3>Edit Service</h3>

            <div class="card shadow">



                <div class="card-body">
                    <form asp-action="EditService" method="post">
                        <div class="mb-3">
                            <label>Name</label>
                            <input asp-for="name"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Description</label>
                            <textarea asp-for="description"
                                      class="form-control"></textarea>
                        </div>

                        <div class="mb-3">
                            <label>Price</label>
                            <input asp-for="price"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                             <label>Status</label>
                             <input asp-for="status" type="radio" id="ac" value="active"/>
<span>Active</span>
                             <input asp-for="status" type="radio" id="ac" value="inactive"/>
<span>InActive</span>
                        </div>

                        <button class="submit-btn mb-3">
                            Submit
                        </button>

                    </form>
                </div>

            </div>

        </div>

    </div>

</div>

@if (TempData["emsg"] != null)
{
    <script>
        alert('@TempData["emsg"]');
    </script>
}