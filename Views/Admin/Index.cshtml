@model project3VehicleServiceBookingApp.Models.DashboardData
@{
}
<div class="container-fluid mt-4" >

    <!-- Dashboard Cards -->
    <div class="row g-4 " style="    margin-top: 30px;">

        <div class="col-md-6">
            <div class="card shadow border-0 h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted">Total Users</h6>
                        <h2 class="fw-bold text-primary">@Model.usercount</h2>
                    </div>
                    <i class="fas fa-users fa-3x text-primary"></i>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow border-0 h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted">Total Bookings</h6>
                        <h2 class="fw-bold text-success">@Model.bcount</h2>
                    </div>
                    <i class="fas fa-calendar-check fa-3x text-success"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- Action Button -->
    <div class="d-flex justify-content-end mt-4">
        <a asp-action="createService" class="btn addbtn px-4">
            <i class="fas fa-plus me-2"></i>
            Add Service
        </a>
    </div>

    <!-- Recent Bookings -->
    <div class="card shadow border-0 mt-4">

        <div class="card-header  text-white" style="background-color: #6c757d">
            <h5 class="mb-0">
                <i class="fas fa-list me-2"></i>
                Recent Bookings
            </h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Booking ID</th>
                            <th>Customer</th>
                            <th>Vehicle</th>
                            <th>Service</th>
                            <th>Booking Date</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>
                            <td>#1001</td>
                            <td>John Mathew</td>
                            <td>Hyundai i20</td>
                            <td>Oil Change</td>
                            <td>23-Jul-2026</td>
                            <td>
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary">
                                    View
                                </button>
                            </td>
                        </tr>

                        <tr>
                            <td>#1002</td>
                            <td>Rahul</td>
                            <td>Swift</td>
                            <td>Car Wash</td>
                            <td>22-Jul-2026</td>
                            <td>
                                <span class="badge bg-success">
                                    Completed
                                </span>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary">
                                    View
                                </button>
                            </td>
                        </tr>

                        <tr>
                            <td>#1003</td>
                            <td>Anjali</td>
                            <td>Kia Sonet</td>
                            <td>Wheel Alignment</td>
                            <td>21-Jul-2026</td>
                            <td>
                                <span class="badge bg-info">
                                    In Progress
                                </span>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary">
                                    View
                                </button>
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div> 