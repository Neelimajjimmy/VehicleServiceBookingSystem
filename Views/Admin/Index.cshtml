@model project3VehicleServiceBookingApp.Models.DashboardData
@{
}
<div class="container-fluid mt-4" >

    <!-- Dashboard Cards -->
    <div class="row g-4 " style="    margin-top: 30px;">

        <div class="col-md-6">
            <div class="card shadow border-0 h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted">Total Users</h6>
                        <h2 class="fw-bold text-primary">@Model.usercount</h2>
                    </div>
                    <i class="fas fa-users fa-3x text-primary"></i>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow border-0 h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted">Total Bookings</h6>
                        <h2 class="fw-bold text-success">@Model.bcount</h2>
                    </div>
                    <i class="fas fa-calendar-check fa-3x text-success"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- Action Button -->
    <div class="d-flex justify-content-end mt-4">
        <a asp-action="createService" class="btn addbtn px-4">
            <i class="fas fa-plus me-2"></i>
            Add Service
        </a>
    </div>

    <!-- Recent Bookings -->
    <div class="card shadow border-0 mt-4">

        <div class="card-header  text-white" style="background-color: #6c757d">
            <h5 class="mb-0">
                <i class="fas fa-list me-2"></i>
                Recent Bookings
            </h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Booking ID</th>
                            <th>Customer</th>
                            <th>Vehicle</th>
                            <th>Service</th>
                            <th>Service Date</th>
                            <th>Status</th>
                            
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in ViewBag.abkings)
                        {
                            <tr>
                                <td>@item.bid</td>
                                <td>@item.uname</td>
                                <td>@item.model</td>
                                <td>@item.sname</td>
                                <td>@item.sdate?.ToString("dd-MM-yyyy")</td>
                                <td>
                                    <span class="badge  @(item.st == "pending" ? "bg-warning text-dark" :
                                                                                      item.st == "confirmed" ? "bg-primary" :
                                                                                      item.st == "completed" ? "bg-success" :
                                                                                      item.st == "cancelled" ? "bg-danger" :
                                                                                      "bg-secondary")">
                                    @item.st
                                </span>
                            </td>
                           
                            </tr>
                                                }


                        

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div> 