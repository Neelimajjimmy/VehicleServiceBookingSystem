
@model project3VehicleServiceBookingApp.Models.AddServiceTypeDto
@{
}
<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">
          <h3>Create Service</h3>

            <div class="card shadow">

              

                <div class="card-body">
                    <form asp-action="createService" method="post">
                        <div class="mb-3">
                            <label>Name</label>
                            <input asp-for="name"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Description</label>
                            <textarea asp-for="description"
                                   class="form-control" ></textarea>
                        </div>

                        <div class="mb-3">
                            <label>Price</label>
                            <input asp-for="price"
                                   class="form-control" />
                        </div>
                       

                        <button class="submit-btn mb-3">
                            Submit
                        </button>
                        
                    </form>
                </div>

            </div>

        </div>

    </div>

</div>

@if (TempData["smsg"] != null)
{
    <script>
        alert('@TempData["smsg"]');
    </script>
}