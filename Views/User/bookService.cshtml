@model project3VehicleServiceBookingApp.Models.BookService
@{
    Layout = "userLayout";
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card border-0 shadow rounded-4">

                <div class="card-body p-4">

                    <h3 class="fw-bold mb-1">
                        <i class="fa-solid fa-calendar-check darkblue me-2"></i>
                        Book Service
                    </h3>

                    <p class="text-muted mb-4">
                        Select your vehicle and preferred service date.
                    </p>


                    <!-- SERVICE -->
                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            Service
                        </label>

                        <div class="card border-primary bg-light">
                            <div class="card-body d-flex align-items-center">

                                <div class="rounded-circle darkblue text-white
                                            d-flex align-items-center justify-content-center me-3"
                                     style="width:50px;height:50px;">

                                    <i class="fa-solid fa-screwdriver-wrench "></i>

                                </div>

                                <div>
                                    <h6 class="mb-1 fw-bold">
                                        @ViewBag.sname
                                    </h6>

                                    
                                </div>

                            </div>
                        </div>

                    </div>
                    <form asp-action="bookService" method="post">
                        <input type="hidden" asp-for="stid" />
@if (ViewBag.vehicles == null )
{
    <div class="text-center py-4">

        <div class="mb-3">

            <i class="fa-solid fa-car fa-3x text-muted"></i>

        </div>

        <h5 class="fw-bold">
            No vehicles added
        </h5>

        <p class="text-muted">
            Add a vehicle before booking a service.
        </p>

        <a asp-controller="User"
                               asp-action="CreateVehicle"
                                   class="btn addbtn">

            <i class="fa-solid fa-plus me-2"></i>
            Add Vehicle

        </a>

    </div>
}
else if (ViewBag.vehicles.Count == 1)
{
    <!-- SINGLE VEHICLE -->

    <div class="mb-4">

        <label class="form-label fw-semibold">
            Your Vehicle
        </label>

        <div class="card border-primary bg-light rounded-3">

            <div class="card-body">

                <div class="d-flex align-items-center">

                                            <div class="rounded-circle darkblue text-white
                                d-flex align-items-center justify-content-center me-3"
                         style="width:55px;height:55px;">

                        <i class="fa-solid fa-car fa-lg"></i>

                    </div>

                    <div>

                        <h5 class="mb-1 fw-bold">
                           @ViewBag.vehicles[0].model
                        </h5>

                        <div class="text-muted">
                            @ViewBag.vehicles[0].regNo
                        </div>

                        <span class="badge bg-secondary mt-1">
                            @ViewBag.vehicles[0].fueltype
                        </span>

                    </div>

                </div>

            </div>

        </div>

                            <input type="hidden"
                                   asp-for="vhid"
                                   value="@ViewBag.vehicles[0].vid" />

                        </div>

                    }
                    else
                    {
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Select Vehicle
                            </label>

                            <div class="row g-3">
                                @foreach (var item in ViewBag.vehicles)
                                {
                                    <!-- Vehicle 1 -->
                                    <div class="col-md-6">

                                        <input type="radio"
                                        class="btn-check"
                                        name="VehicleId"
                                        id="vehicle1"
                                        value="@item.vid"
                                        asp-for="vhid">

                                        <label class="vehicle-card"
                                        for="vehicle1">

                                            <div class="d-flex align-items-center">

                                                <i class="fa-solid fa-car fa-2x text-primary me-3"></i>

                                                <div>
                                                    <h6 class="mb-1 fw-bold">
                                                        @item.model
                                                    </h6>

                                                    <div class="text-muted small">
                                                       @item.regNo
                                                    </div>

                                                    <span class="badge bg-secondary mt-1">
                                                       @item.fueltype
                                                    </span>
                                                </div>

                                            </div>

                                        </label>

                                    </div>
                                }

                               </div>
                               </div>
    
}
                    <!-- SERVICE DATE -->
                    <div class="mb-4">

                        <label asp-for="sdate"
                               class="form-label fw-semibold">
                            Service Date
                        </label>

                        <input asp-for="sdate"
                               type="date"
                               class="form-control form-control-lg">

                        

                    </div>


                    <!-- BUTTON -->
                    <div class="d-grid">

                        <button type="submit"
                                    class="btn addbtn btn-lg rounded-3">

                            <i class="fa-solid fa-calendar-check me-2"></i>
                            Confirm Booking

                        </button>

                    </div>
                    </form>
                </div>

            </div>

        </div>
    </div>

</div>