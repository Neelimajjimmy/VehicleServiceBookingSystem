@{
    Layout = "userLayout";
}
<div class="card shadow border-0 mt-4">

    <div class="card-header  text-white" style="background-color: #6c757d">
        <h5 class="mb-0">
            <i class="fas fa-list me-2"></i>
             Bookings
        </h5>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        
                        <th>Vehicle</th>
                        <th>Service</th>
                        <th>Booking Date</th>
                        <th>Service Date</th>
                        <th>Status</th>
                       
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in ViewBag.userBooks)
                    {
                        <tr>
                           
                            <td>@item.model</td>
                            <td>@item.sname</td>
                            <td>@item.bdate</td>
                            <td>@item.sdate</td>
                            <td>
                                <span class="badge  @(item.st == "pending" ? "bg-warning text-dark" :
                                            item.st == "confirmed" ? "bg-primary" :
                                            item.st == "completed" ? "bg-success" :
                                            item.st == "cancelled" ? "bg-danger" :
                                            "bg-secondary")">
                                   @item.st
                                </span>
                            </td>
                            
                        </tr>
                    }
                    

                </tbody>

            </table>

        </div>

    </div>

</div>

</div> 