@{
    Layout = "userLayout";
}
<style>
    h2{
        color:darkblue;
    }
    .pricetext{
        color: darkblue;
    }
</style>
<div class="container mt-4">

    <!-- Welcome -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h2 class="fw-bold">
                Hello,@Context.Session.GetString("username")👋
            </h2>
            <p class=" mb-0">
                Welcome back! Here's a quick overview of your account.
            </p>
        </div>
    </div>

    <!-- Dashboard Cards -->
    <div class="row g-4 mb-5">
       
            <div class="col-lg-4 col-md-6">
                <div class="card shadow border-0 rounded-4 h-100">
                <div class="card-body text-center">

                    <i class="fa-solid fa-car fa-3x text-primary mb-3"></i>

                    <h5>My Vehicles</h5>

                    <h2 class="fw-bold text-primary">
                        2
                    </h2>

                    <a href="#" class="btn btn-outline-primary mt-3">
                        View Vehicles
                    </a>

                </div>
            </div>
        </div>
        
        <div class="col-lg-4 col-md-6">
            <div class="card shadow border-0 rounded-4 h-100">
                <div class="card-body text-center">

                    <i class="fa-solid fa-calendar-check fa-3x text-success mb-3"></i>

                    <h5>Upcoming Bookings</h5>

                    <h2 class="fw-bold text-success">
                        1
                    </h2>

                    <a href="#" class="btn btn-outline-success mt-3">
                        View Bookings
                    </a>

                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="card shadow border-0 rounded-4 h-100">
                <div class="card-body text-center">

                    <i class="fa-solid fa-circle-check fa-3x text-info mb-3"></i>

                    <h5>Completed Services</h5>

                    <h2 class="fw-bold text-info">
                        8
                    </h2>

                    <a href="#" class="btn btn-outline-info mt-3">
                        Service History
                    </a>

                </div>
            </div>
        </div>

    </div>

    <!-- Available Services -->
    <div class="mb-4">

        <h3 class="fw-bold mb-3">
            Available Services
        </h3>

        <div class="row g-4">
 @foreach (var item in ViewBag.services)
            {
                <div class="col-lg-4">

                <div class="card shadow-sm h-100 border-0">

                        <i class="fa-solid fa-wrench"></i>

                    <div class="card-body">

                        <h5>@item.name</h5>

                        <p class="text-muted">
                           @item.description
                        </p>

                            <h5 class="pricetext">
                            ₹@item.price
                        </h5>

                        <button class="btn addbtn w-100">
                            Book Now
                        </button>

                    </div>

                </div>

            </div>
}
           

        </div>

    </div>

